{
  "name": "rn-pear-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "standard": {
    "globals": [
      "BareKit"
    ]
  },
  "private": true,
  "author": {
    "name": "Amresh Vs",
    "email": "vsamreshpro@gmail.com",
    "url": "https://github.com/AmreshVs"
  },
  "scripts": {
    "start:clean": "watchman watch-del $PWD; watchman watch-project $PWD && expo start --dev-client --clear",
    "android": "expo run:android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "ios": "expo run:ios",
    "schema": "node ./src/spec/schema.js",
    "bare-bundle": " npx bare-pack --host ios --host android  --linked --out src/backend/backend.bundle.js src/backend/backend.js",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "kickstart": "node scripts/kickstart.js"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^55.0.4",
    "expo-constants": "~55.0.7",
    "expo-device": "~55.0.9",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.3",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "framed-stream": "^1.0.1",
    "hrpc": "^4.3.0",
    "lucide-react-native": "^0.575.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-bare-kit": "^0.12.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@react-native/typescript-config": "^0.84.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "bare-pack": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
