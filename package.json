{
  "name": "rn-pear-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "standard": {
    "globals": [
      "BareKit"
    ]
  },
  "private": true,
  "author": {
    "name": "Amresh Vs",
    "email": "vsamreshpro@gmail.com",
    "url": "https://github.com/AmreshVs"
  },
  "scripts": {
    "start:clean": "watchman watch-del $PWD; watchman watch-project $PWD && expo start --dev-client --clear",
    "android": "expo run:android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "ios": "expo run:ios",
    "schema": "node ./spec/schema.js",
    "bare-bundle": " npx bare-pack --host ios --host android  --linked --out backend/backend.bundle.js backend/backend.js",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "kickstart": "node scripts/kickstart.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "framed-stream": "^1.0.1",
    "hrpc": "^4.3.0",
    "lucide-react-native": "^0.575.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.12.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@react-native/typescript-config": "^0.84.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.10",
    "bare-pack": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
